{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "auth",
    "type": "object",
    "title": "Auth",
    "properties": {
        "token": {
            "type": "string",
            "title": "Bot token"
        },
        "owner": {
            "type": "string",
            "title": "Owner id"
        },
        "geminiKey": {
            "title": "Gemini API key, or a list of keys used in turn when one runs out",
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "minItems": 1
                }
            ]
        }
    }
}
