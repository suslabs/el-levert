{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "config",
    "title": "Config",
    "type": "object",
    "properties": {
        "logFile": {
            "type": "string"
        },
        "importLogFile": {
            "type": "string"
        },
        "eventsPath": {
            "type": "string"
        },
        "commandsPath": {
            "type": "string"
        },
        "cliCommandsPath": {
            "type": "string"
        },
        "websocketCommandsPath": {
            "type": "string"
        },
        "dbPath": {
            "type": "string"
        },
        "logLevel": {
            "type": "string"
        },
        "cmdPrefix": {
            "type": "string"
        },
        "enableCliCommands": {
            "type": "boolean"
        },
        "cliCmdPrefix": {
            "type": "string"
        },
        "enableWebsocket": {
            "type": "boolean"
        },
        "serverHost": {
            "type": "string"
        },
        "websocketPort": {
            "type": "number"
        },
        "outCharLimit": {
            "type": "number"
        },
        "outLineLimit": {
            "type": "number"
        },
        "embedCharLimit": {
            "type": "number"
        },
        "embedLineLimit": {
            "type": "number"
        },
        "errorCharLimit": {
            "type": "number"
        },
        "maxFileSize": {
            "type": "number"
        },
        "commandRateLimit": {
            "type": "number"
        },
        "commandRateLimitWindow": {
            "type": "number"
        },
        "minResponseTime": {
            "type": "number"
        },
        "globalTimeLimit": {
            "type": "number"
        },
        "commandWaitTime": {
            "type": "number"
        },
        "interactionTimeout": {
            "type": "number"
        },
        "reminderMsgLimit": {
            "type": "number"
        },
        "reminderSendInterval": {
            "type": "number"
        },
        "maxTagNameLength": {
            "type": "number"
        },
        "tagNameRegex": {
            "type": "string"
        },
        "maxTagSize": {
            "type": "object",
            "properties": {
                "text": {
                    "type": "number"
                },
                "script": {
                    "type": "number"
                },
                "binary": {
                    "type": "number"
                }
            },
            "required": ["text", "script", "binary"],
            "additionalProperties": false
        },
        "maxQuota": {
            "type": "number"
        },
        "maxTagCount": {
            "type": "number"
        },
        "memLimit": {
            "type": "number"
        },
        "timeLimit": {
            "type": "number"
        },
        "otherMemLimit": {
            "type": "number"
        },
        "otherTimeLimit": {
            "type": "number"
        },
        "vmInspector": {
            "type": "object",
            "properties": {
                "enable": {
                    "type": "boolean"
                },
                "enableUser": {
                    "type": "boolean"
                },
                "connectTimeout": {
                    "type": "number"
                },
                "userConnectTimeout": {
                    "type": "number"
                },
                "userActionTimeout": {
                    "type": "number"
                },
                "port": {
                    "type": "number"
                }
            },
            "required": ["enable", "enableUser", "connectTimeout", "userConnectTimeout", "userActionTimeout", "port"],
            "additionalProperties": false
        },
        "maxGroupNameLength": {
            "type": "number"
        },
        "tagModeratorLevel": {
            "type": "number"
        },
        "permissionAdminLevel": {
            "type": "number"
        },
        "enablePreviews": {
            "type": "boolean"
        },
        "enableSed": {
            "type": "boolean"
        },
        "enableEval": {
            "type": "boolean"
        },
        "enableAI": {
            "type": "boolean"
        },
        "enableOtherLangs": {
            "type": "boolean"
        },
        "enableVM2": {
            "type": "boolean"
        },
        "enablePermissions": {
            "type": "boolean"
        },
        "enableReminders": {
            "type": "boolean"
        },
        "enableAuditLog": {
            "type": "boolean"
        },
        "enableGlobalHandler": {
            "type": "boolean"
        },
        "wrapEvents": {
            "type": "boolean"
        },
        "setActivity": {
            "type": "boolean"
        },
        "activity": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string"
                },
                "text": {
                    "type": "string"
                }
            },
            "required": ["type", "text"]
        },
        "mentionUsers": {
            "type": "boolean"
        },
        "pingReply": {
            "type": "boolean"
        },
        "logToDiscord": {
            "type": "boolean"
        },
        "discordLogLevel": {
            "type": "string"
        },
        "logChannelId": {
            "type": "string"
        },
        "logWebhook": {
            "type": "string"
        },
        "emoji": {
            "type": "object",
            "properties": {
                "info": { "type": "string" },
                "warn": { "type": "string" },
                "error": { "type": "string" },
                "ok": { "type": "string" },
                "invalid": { "type": "string" },
                "waiting": { "type": "string" },
                "clock": { "type": "string" }
            },
            "required": ["info", "warn", "error", "ok", "invalid", "waiting", "clock"]
        },
        "bridgeBotIds": {
            "type": "array"
        },
        "bridgeBotMessageFormat": {
            "type": "string"
        },
        "bridgeBotMessageFormats": {
            "oneOf": [
                {
                    "type": "array"
                },
                {
                    "type": "object"
                }
            ]
        },
        "vmHttp": {
            "type": "object",
            "properties": {
                "maxUploadSize": {
                    "type": "number"
                },
                "maxDownloadSize": {
                    "type": "number"
                },
                "maxRequests": {
                    "type": "number"
                },
                "rateLimitWindow": {
                    "type": "number"
                },
                "allowLocalhostRequests": {
                    "type": "boolean"
                },
                "allowFilesystemRequests": {
                    "type": "boolean"
                }
            },
            "required": [
                "maxUploadSize",
                "maxDownloadSize",
                "maxRequests",
                "rateLimitWindow",
                "allowLocalhostRequests",
                "allowFilesystemRequests"
            ],
            "additionalProperties": false
        },
        "ai": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "promptsPath": {
                    "type": "string",
                    "minLength": 1
                },
                "icon": {
                    "type": ["string", "null"]
                },
                "endpoint": {
                    "type": "string"
                },
                "models": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1
                },
                "thinkingLevel": {
                    "type": ["string", "null"]
                },
                "maxSteps": {
                    "type": "integer",
                    "anyOf": [{ "const": -1 }, { "minimum": 1 }]
                },
                "timeLimit": {
                    "type": "number"
                },
                "requestTimeout": {
                    "type": "number"
                },
                "maxDownloadSize": {
                    "type": "number"
                },
                "maxToolOutput": {
                    "type": "integer",
                    "minimum": 1
                },
                "maxRequests": {
                    "type": "integer",
                    "minimum": 1
                },
                "rateLimitWindow": {
                    "type": "number",
                    "minimum": 0
                },
                "followUpsAnyone": {
                    "type": "boolean"
                },
                "followUpsEditAnswer": {
                    "type": "boolean"
                },
                "allowLocalhostRequests": {
                    "type": "boolean"
                },
                "recipes": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "searchUrls": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            },
                            "minItems": 1
                        },
                        "shotUrl": {
                            "type": "string",
                            "minLength": 1
                        },
                        "siteUrl": {
                            "type": "string",
                            "minLength": 1
                        },
                        "mode": {
                            "enum": ["normal", "expert"]
                        }
                    },
                    "required": ["enabled", "searchUrls", "shotUrl", "siteUrl", "mode"],
                    "additionalProperties": false
                }
            },
            "required": [
                "name",
                "icon",
                "promptsPath",
                "endpoint",
                "models",
                "thinkingLevel",
                "maxSteps",
                "timeLimit",
                "requestTimeout",
                "maxDownloadSize",
                "maxToolOutput",
                "maxRequests",
                "rateLimitWindow",
                "followUpsAnyone",
                "followUpsEditAnswer",
                "allowLocalhostRequests",
                "recipes"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "logFile",
        "importLogFile",
        "eventsPath",
        "commandsPath",
        "cliCommandsPath",
        "websocketCommandsPath",
        "dbPath",
        "logLevel",
        "cmdPrefix",
        "enableCliCommands",
        "cliCmdPrefix",
        "enableWebsocket",
        "serverHost",
        "websocketPort",
        "outCharLimit",
        "outLineLimit",
        "embedCharLimit",
        "embedLineLimit",
        "errorCharLimit",
        "maxFileSize",
        "commandRateLimit",
        "commandRateLimitWindow",
        "minResponseTime",
        "globalTimeLimit",
        "commandWaitTime",
        "interactionTimeout",
        "reminderMsgLimit",
        "reminderSendInterval",
        "maxTagNameLength",
        "tagNameRegex",
        "maxTagSize",
        "maxQuota",
        "maxTagCount",
        "memLimit",
        "timeLimit",
        "otherMemLimit",
        "otherTimeLimit",
        "vmInspector",
        "maxGroupNameLength",
        "tagModeratorLevel",
        "permissionAdminLevel",
        "enablePreviews",
        "enableSed",
        "enableEval",
        "enableAI",
        "enableOtherLangs",
        "enableVM2",
        "enablePermissions",
        "enableReminders",
        "enableAuditLog",
        "enableGlobalHandler",
        "wrapEvents",
        "setActivity",
        "activity",
        "mentionUsers",
        "pingReply",
        "logToDiscord",
        "discordLogLevel",
        "logChannelId",
        "logWebhook",
        "emoji",
        "bridgeBotIds",
        "vmHttp",
        "ai"
    ],
    "anyOf": [
        {
            "required": ["bridgeBotMessageFormat"]
        },
        {
            "required": ["bridgeBotMessageFormats"]
        }
    ]
}
