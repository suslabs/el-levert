{
    "logFile": "./logs/bot.log",
    "importLogFile": "./logs/import.log",
    "eventsPath": "./src/events",
    "commandsPath": "./src/commands",
    "cliCommandsPath": "./src/commands/cli",
    "websocketCommandsPath": "./src/commands/websocket",
    "dbPath": "./db",
    "logLevel": "debug",
    "cmdPrefix": "%",
    "enableCliCommands": true,
    "cliCmdPrefix": ".",
    "enableWebsocket": true,
    "websocketPort": 8081,
    "outCharLimit": 2000,
    "outLineLimit": 16,
    "embedCharLimit": 3000,
    "embedLineLimit": 40,
    "errorCharLimit": 1000,
    "commandRateLimit": 60,
    "commandRateLimitWindow": 60,
    "minResponseTime": 0.1,
    "globalTimeLimit": 60,
    "commandWaitTime": 3,
    "interactionTimeout": 300,
    "reminderMsgLimit": 512,
    "reminderSendInterval": 10,
    "maxTagNameLength": 32,
    "tagNameRegex": "^[A-Za-z0-9\\-_]+$",
    "maxTagSize": {
        "text": 100,
        "script": 100,
        "binary": 100
    },
    "maxQuota": 1024,
    "maxTagCount": 10000,
    "memLimit": 250,
    "timeLimit": 15,
    "otherMemLimit": 50,
    "otherTimeLimit": 15,
    "vmInspector": {
        "enable": false,
        "enableUser": false,
        "connectTimeout": 60,
        "userConnectTimeout": 30,
        "userActionTimeout": 300,
        "port": 8080
    },
    "maxGroupNameLength": 16,
    "tagModeratorLevel": 1,
    "permissionAdminLevel": 2,
    "enablePreviews": true,
    "enableSed": true,
    "enableEval": true,
    "enableOtherLangs": false,
    "enableVM2": false,
    "enablePermissions": true,
    "enableReminders": true,
    "enableAuditLog": true,
    "enableGlobalHandler": true,
    "wrapEvents": true,
    "setActivity": false,
    "activity": {
        "type": "watching",
        "text": "example"
    },
    "mentionUsers": false,
    "pingReply": true,
    "logToDiscord": false,
    "discordLogLevel": "info",
    "logChannelId": "",
    "logWebhook": "",
    "emoji": {
        "info": ":information_source:",
        "warn": ":warning:",
        "error": ":no_entry_sign:",
        "ok": ":white_check_mark:",
        "invalid": ":police_car:",
        "waiting": ":hourglass_flowing_sand:",
        "clock": ":clock3:"
    },
    "bridgeBotIds": [],
    "bridgeBotMessageFormat": "\\*{2}.+?:\\*{2}\\s",
    "vmHttp": {
        "maxUploadSize": 50,
        "maxDownloadSize": 50,
        "maxRequests": 20,
        "rateLimitWindow": 1,
        "allowLocalhostRequests": false,
        "allowFilesystemRequests": false
    }
}
